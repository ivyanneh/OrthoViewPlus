/* =========================================================================
   OrthoView+ clinical workstation theme
   Supports Light & Dark themes dynamically via data-theme attribute
   ========================================================================= */

/* 1. Default (Light Mode) Variables */
:root,
[data-theme='light'],
body.light {
  color-scheme: light;

  --bg-deep: #0D1928;
  --bg: #F4F6F8;
  --surface: #FFFFFF;
  --surface-2: #F4F6F8;
  --surface-3: #E2E7EC;
  --input: #FFFFFF;

  --ink: #1e293b;
  --ink-2: #334155;
  --muted: #64748b;
  --faint: #94a3b8;
  --line: #E2E7EC;
  --line-strong: #CBD5E1;

  --accent: #159A91;
  --accent-2: #117e77;
  --accent-soft: #DDF3F0;
  --ring: rgba(21, 154, 145, 0.28);
  --primary: #159A91;
  --primary-hover: #117e77;

  --sidebar-bg: #142438;
  --sidebar-border: #0D1928;
  --sidebar-text: #DDF3F0;
  --sidebar-muted: #c5d0dc;
  --sidebar-active: rgba(21, 154, 145, 0.22);
  --topbar-bg: #FFFFFF;
  --topbar-text: #0f172a;

  --ok: #159A91;
  --ok-soft: #DDF3F0;
  --ok-line: #159A91;
  --warn: #E5A23B;
  --warn-soft: rgba(229, 162, 59, 0.12);
  --warn-line: #E5A23B;
  --danger: #D9534F;
  --danger-soft: rgba(217, 83, 79, 0.12);
  --danger-line: #D9534F;
  --info: #159A91;
  --info-soft: #DDF3F0;
  --info-line: #159A91;
  --neutral: #697586;
  --neutral-soft: #F4F6F8;
  --neutral-line: #E2E7EC;

  --radius: 4px;
  --radius-lg: 6px;
  --shadow-pop: 0 18px 48px rgba(0, 0, 0, 0.15);
  --font: "Inter", "Segoe UI Variable Text", "Segoe UI", system-ui, -apple-system, sans-serif;
  --mono: "Cascadia Mono", "JetBrains Mono", Consolas, monospace;

  --sidebar-width: 232px;
  --bar-height: 56px;
}

/* 2. Dark Mode Overrides */
[data-theme='dark'],
body.dark {
  color-scheme: dark;

  --bg-deep: #070d14;
  --bg: #0d1928;
  --surface: #142438;
  --surface-2: #1b2e46;
  --surface-3: #243b59;
  --input: #101e30;

  --ink: #f8fafc;
  --ink-2: #cbd5e1;
  --muted: #8899a6;
  --faint: #607080;
  --line: #1f334d;
  --line-strong: #2a4365;

  --sidebar-bg: #09121d;
  --sidebar-border: #1f334d;
  --sidebar-text: #ddf3f0;
  --sidebar-muted: #8899a6;
  --sidebar-active: rgba(21, 154, 145, 0.35);
  --topbar-bg: rgba(13, 25, 40, 0.95);
  --topbar-text: #f8fafc;

  --shadow-pop: 0 18px 48px rgba(0, 0, 0, 0.65);
}

/* =========================================================================
   Component Bindings (Variable Dynamic Mapping)
   ========================================================================= */

.sidebar {
  position: sticky;
  top: 0;
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: var(--sidebar-bg);
  border-right: 1px solid var(--sidebar-border);
  color: var(--sidebar-text);
}

.topbar {
  position: sticky;
  top: 0;
  z-index: 5;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 1.5rem;
  height: var(--bar-height);
  padding: 0 1.5rem;
  background: var(--topbar-bg);
  border-bottom: 1px solid var(--line);
  backdrop-filter: blur(6px);
}

.topbar-title h2,
.stat-card .value,
.summary-strip strong {
  color: var(--ink);
}