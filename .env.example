# Copy this file to server/.env and adjust values for your environment.

PORT=3001
CLIENT_ORIGIN=http://localhost:5173

# Used to sign authentication tokens. Change this in any non-local environment.
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_IN=8h

# SQLite database file path (relative to the server folder unless absolute)
DATABASE_PATH=./data/orthoviewplus.db

# Development administrator account created on first backend start if missing.
# Do not use these credentials outside local development.
DEV_ADMIN_USERNAME=admin
DEV_ADMIN_PASSWORD=OrthoViewDev2026!

# Orthanc DICOM server (never exposed to the React frontend)
ORTHANC_URL=http://localhost:8042
ORTHANC_USERNAME=orthanc
ORTHANC_PASSWORD=orthanc
